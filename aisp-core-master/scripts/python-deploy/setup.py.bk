#!/usr/bin/env python
# -*- coding: utf-8 -*-

try:
    from setuptools import setup, find_packages
except ImportError:
    from distutils.core import setup, find_packages

install_requires = [
    'zhihu-protobuf'
]
setup(
    name='aisp-proto-<%service_name%>',
    version='<%version%>',
    author='wangran',
    author_email='wangran@zhihu.com',
    packages=['aisp_proto_<%service_name%>'],
    zip_safe=False,
    install_requires=['zhihu-protobuf==2.6.1'],
)
