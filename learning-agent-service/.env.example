LEARNING_AGENT_SERVICE_NAME=learning-agent-service
LEARNING_AGENT_ENV=local
LEARNING_AGENT_WORKFLOW_VERSION=learn-agent/v1
LEARNING_AGENT_INTERNAL_API_TOKEN=local-learning-agent-token
LEARNING_AGENT_JAVA_BUSINESS_INTERNAL_TOKEN=local-learning-agent-token

# Local developer defaults:
# - false: prefer lightweight fallback adapters so the service can start more easily
# - true: keep running even if Postgres / Qdrant are not ready yet
LEARNING_AGENT_PREFER_REAL_ADAPTERS=false
LEARNING_AGENT_ALLOW_IN_MEMORY_FALLBACK=true

# Workflow / architecture feature flags
# - phase 0: tracing and harnesses
# - phase 1: route review and required facets
# - phase 2: partial grounded / slot clarify
# - phase 3: task plan trial
# - phase 4: answer verifier
LEARNING_AGENT_ENABLE_ROUTE_REVIEW=true
LEARNING_AGENT_ENABLE_REQUIRED_FACETS=true
LEARNING_AGENT_ENABLE_REQUIRED_FACETS_TO_PLANS=true
LEARNING_AGENT_ENABLE_MIN_ENTITY_CONSISTENCY_CHECK=true
LEARNING_AGENT_ENABLE_TRACE_HARNESS=false
LEARNING_AGENT_ENABLE_REPLAY_HARNESS=false
LEARNING_AGENT_ENABLE_TOOL_MOCK_HARNESS=false
LEARNING_AGENT_ENABLE_RAG_GOLDEN_EVIDENCE_HARNESS=false
LEARNING_AGENT_ENABLE_EVALUATION_HARNESS=false
LEARNING_AGENT_ENABLE_PARTIAL_GROUNDED=true
LEARNING_AGENT_ENABLE_SLOT_CLARIFY=true
LEARNING_AGENT_ENABLE_RAG_PLUS_TOOL_PARTIAL_ANSWER=true
LEARNING_AGENT_ENABLE_TASK_PLAN_FOR_LOCAL_LIFE=true
LEARNING_AGENT_ENABLE_ANSWER_VERIFIER=true
LEARNING_AGENT_ANSWER_VERIFIER_MODE=warn_only

LEARNING_AGENT_POSTGRES_DSN=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/learning_agent
LEARNING_AGENT_POSTGRES_POOL_SIZE=10

LEARNING_AGENT_REDIS_URL=redis://localhost:6379/0
LEARNING_AGENT_REDIS_KEY_PREFIX=learn

LEARNING_AGENT_QDRANT_URL=http://localhost:6333
LEARNING_AGENT_QDRANT_API_KEY=
LEARNING_AGENT_QDRANT_KNOWLEDGE_COLLECTION=knowledge_chunks
LEARNING_AGENT_QDRANT_USER_MEMORY_COLLECTION=user_semantic_memory

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LEARNING_AGENT_OPENAI_RESPONSES_MODEL=gpt-5.4
LEARNING_AGENT_OPENAI_TIMEOUT_SECONDS=60

LEARNING_AGENT_LOG_LEVEL=INFO
LEARNING_AGENT_REQUEST_TIMEOUT_SECONDS=30
