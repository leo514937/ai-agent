LEARNING_AGENT_SERVICE_NAME=learning-agent-service
LEARNING_AGENT_ENV=local
LEARNING_AGENT_WORKFLOW_VERSION=learn-agent/v1
LEARNING_AGENT_INTERNAL_API_TOKEN=YOUR_INTERNAL_API_TOKEN_HERE
LEARNING_AGENT_JAVA_BUSINESS_INTERNAL_TOKEN=YOUR_INTERNAL_API_TOKEN_HERE
LEARNING_AGENT_DEBUG=false

# 所有能力尽量走真实后端；如果某些外部服务还没配好，允许临时回退，避免服务直接起不来
LEARNING_AGENT_PREFER_REAL_ADAPTERS=true
LEARNING_AGENT_ALLOW_IN_MEMORY_FALLBACK=true

# LangGraph 持久化
LEARNING_AGENT_WORKFLOW_CHECKPOINT_ENABLED=true
LEARNING_AGENT_WORKFLOW_CHECKPOINT_SQLITE_PATH=var/langgraph/checkpoints.sqlite

# 真实存储后端
LEARNING_AGENT_POSTGRES_DSN=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/learning_agent
LEARNING_AGENT_POSTGRES_ECHO=false
LEARNING_AGENT_POSTGRES_POOL_SIZE=10
LEARNING_AGENT_POSTGRES_MAX_OVERFLOW=10
LEARNING_AGENT_POSTGRES_POOL_PRE_PING=true

LEARNING_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
LEARNING_AGENT_REDIS_KEY_PREFIX=learn
LEARNING_AGENT_REDIS_SOCKET_TIMEOUT_SECONDS=5
LEARNING_AGENT_REDIS_SESSION_TTL_SECONDS=86400
LEARNING_AGENT_REDIS_SUMMARY_TTL_SECONDS=86400
LEARNING_AGENT_REDIS_CLARIFICATION_TTL_SECONDS=3600
LEARNING_AGENT_REDIS_TOOL_CACHE_TTL_SECONDS=900

LEARNING_AGENT_QDRANT_URL=http://127.0.0.1:6333
LEARNING_AGENT_QDRANT_API_KEY=YOUR_QDRANT_API_KEY_HERE
LEARNING_AGENT_QDRANT_TIMEOUT_SECONDS=5
LEARNING_AGENT_QDRANT_PREFER_GRPC=false
LEARNING_AGENT_QDRANT_KNOWLEDGE_COLLECTION=knowledge_chunks
LEARNING_AGENT_QDRANT_USER_MEMORY_COLLECTION=user_semantic_memory
LEARNING_AGENT_QDRANT_KNOWLEDGE_VECTOR_NAME=embedding
LEARNING_AGENT_QDRANT_KNOWLEDGE_SPARSE_VECTOR_NAME=sparse_embedding

# OpenRouter / Responses API
LEARNING_AGENT_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
LEARNING_AGENT_OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LEARNING_AGENT_OPENAI_RESPONSES_MODEL=openai/gpt-4o-mini
LEARNING_AGENT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LEARNING_AGENT_OPENAI_TIMEOUT_SECONDS=60
LEARNING_AGENT_OPENAI_MAX_RETRIES=2

# 检索 / 改写 / 排序开关
LEARNING_AGENT_ENABLE_ONLINE_DENSE_RETRIEVAL=true
LEARNING_AGENT_ENABLE_ONLINE_SPARSE_RETRIEVAL=true
LEARNING_AGENT_ENABLE_BM25_SPARSE_RETRIEVAL=true
LEARNING_AGENT_ENABLE_REMOTE_RERANKER=true
LEARNING_AGENT_RERANKER_PROVIDER=remote
LEARNING_AGENT_REMOTE_RERANKER_ENDPOINT=https://YOUR_RERANKER_HOST/v1/rerank
LEARNING_AGENT_REMOTE_RERANKER_API_KEY=YOUR_RERANKER_API_KEY_HERE
LEARNING_AGENT_REMOTE_RERANKER_MODEL=YOUR_RERANKER_MODEL_NAME
LEARNING_AGENT_REMOTE_RERANKER_TIMEOUT_SECONDS=10
LEARNING_AGENT_ENABLE_LLM_QUERY_REWRITE=true
LEARNING_AGENT_LLM_QUERY_REWRITE_MIN_QUERY_LENGTH=6
LEARNING_AGENT_LLM_QUERY_REWRITE_LOW_CONFIDENCE_THRESHOLD=0.5
LEARNING_AGENT_LLM_QUERY_REWRITE_MODEL=openai/gpt-4o-mini
LEARNING_AGENT_LLM_QUERY_REWRITE_TEMPERATURE=0.0
LEARNING_AGENT_ENABLE_HYDE_SPARSE_RETRIEVAL=true
LEARNING_AGENT_HYDE_SPARSE_RETRIEVAL_MODEL=openai/gpt-4o-mini
LEARNING_AGENT_HYDE_SPARSE_RETRIEVAL_TEMPERATURE=0.0

# 路由 / 质量阈值
LEARNING_AGENT_INTENT_CONFIDENCE_THRESHOLD=0.5
LEARNING_AGENT_REFERENCE_RESOLUTION_CONFIDENCE_THRESHOLD=0.5
LEARNING_AGENT_METADATA_FILTER_CONFIDENCE_THRESHOLD=0.5
LEARNING_AGENT_LOW_SCORE_THRESHOLD=0.18
LEARNING_AGENT_EVIDENCE_STRONG_SCORE_THRESHOLD=0.45
LEARNING_AGENT_TOPIC_CONSISTENCY_THRESHOLD=0.35
LEARNING_AGENT_DEDUP_SIMILARITY_THRESHOLD=0.82
LEARNING_AGENT_REWRITE_RETRY_LIMIT=1

# BM25 / RRF
LEARNING_AGENT_BM25_K1=1.5
LEARNING_AGENT_BM25_B=0.75
LEARNING_AGENT_RRF_DENSE_WEIGHT=1.0
LEARNING_AGENT_RRF_SPARSE_WEIGHT=1.0
LEARNING_AGENT_RRF_METADATA_WEIGHT=0.6

# 记忆 / 决策 / 注入
LEARNING_AGENT_MEMORY_RETRIEVAL_PROMPT_LIMIT=4
LEARNING_AGENT_MEMORY_RETRIEVAL_STATE_LIMIT=6
LEARNING_AGENT_MEMORY_RETRIEVAL_RAG_LIMIT=6
LEARNING_AGENT_MEMORY_RETRIEVAL_TOOL_LIMIT=4
LEARNING_AGENT_MEMORY_RETRIEVAL_TOKEN_BUDGET=1200
LEARNING_AGENT_MEMORY_RETRIEVAL_SEMANTIC_TOP_K=5
LEARNING_AGENT_MEMORY_RETRIEVAL_EPISODIC_KEYWORDS=recent,history,previous,earlier
LEARNING_AGENT_MEMORY_RETRIEVAL_PROCEDURAL_KEYWORDS=how to,步骤,流程,procedure,procedure steps
LEARNING_AGENT_MEMORY_INJECTION_PROMPT_LIMIT=4
LEARNING_AGENT_MEMORY_INJECTION_STATE_LIMIT=8
LEARNING_AGENT_MEMORY_INJECTION_TOOL_LIMIT=4
LEARNING_AGENT_MEMORY_INJECTION_RAG_LIMIT=6
LEARNING_AGENT_MEMORY_INJECTION_TOKEN_BUDGET=1200
LEARNING_AGENT_MEMORY_GOVERNANCE_LOW_CONFIDENCE_THRESHOLD=0.35
LEARNING_AGENT_MEMORY_GOVERNANCE_LOW_STABILITY_THRESHOLD=0.45
LEARNING_AGENT_MEMORY_CONFLICT_SUPERSEDE_MARGIN=0.05
LEARNING_AGENT_MEMORY_CONFLICT_MERGE_SIMILARITY_THRESHOLD=0.65
LEARNING_AGENT_MEMORY_PROMOTION_PREFERENCE_PROMOTE_COUNT=3
LEARNING_AGENT_MEMORY_PROMOTION_BEHAVIOR_PROMOTE_COUNT=2
LEARNING_AGENT_MEMORY_RECOMMENDATION_LOW_MASTERY_THRESHOLD=0.45
LEARNING_AGENT_MEMORY_RECOMMENDATION_REVIEW_PRIORITY_THRESHOLD=60.0
LEARNING_AGENT_MASTERY_REVIEW_PRIORITY_BASE_MASTERY=0.65
LEARNING_AGENT_MASTERY_REVIEW_PRIORITY_WEAK_SIGNAL_BONUS=15.0
LEARNING_AGENT_MASTERY_REVIEW_PRIORITY_LOW_EVIDENCE_THRESHOLD=3
LEARNING_AGENT_MASTERY_REVIEW_PRIORITY_LOW_EVIDENCE_BONUS=8.0
LEARNING_AGENT_MASTERY_REVIEW_PRIORITY_NEGATIVE_SIGNAL_BONUS=5.0
LEARNING_AGENT_MASTERY_REVIEW_PRIORITY_NEGATIVE_SIGNAL_CAP=20.0
LEARNING_AGENT_MASTERY_REVIEW_PRIORITY_HIGH_MASTERY_THRESHOLD=0.75
LEARNING_AGENT_MASTERY_REVIEW_PRIORITY_HIGH_MASTERY_BONUS=-10.0
LEARNING_AGENT_CONSOLIDATION_MINIMUM_DUPLICATE_GROUP_SIZE=2
LEARNING_AGENT_CONSOLIDATION_MAX_CONFLICTS=8
LEARNING_AGENT_CONSOLIDATION_CONFIRMED_EXPLICITNESS=1.0
LEARNING_AGENT_CONSOLIDATION_INFERRED_EXPLICITNESS=0.5
LEARNING_AGENT_CONSOLIDATION_RECENCY_WINDOW_SECONDS=604800
LEARNING_AGENT_ORCHESTRATOR_CONFIRMED_CONFIDENCE_THRESHOLD=0.8

# 运行与日志
LEARNING_AGENT_LOG_LEVEL=INFO
LEARNING_AGENT_JSON_LOGS=true
LEARNING_AGENT_LOG_INCLUDE_CALLER=false
LEARNING_AGENT_OUTBOX_BATCH_SIZE=100
LEARNING_AGENT_OUTBOX_POLL_INTERVAL_SECONDS=1.0
LEARNING_AGENT_REQUEST_TIMEOUT_SECONDS=30
